# ==============================================================================
# CONLIZ PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copie para `.env` (que o Git ignora) e preencha os segredos.
# NUNCA faça commit de credenciais reais.

# ------------------------------------------------------------------------------
# ENVIRONMENT & GENERAL
# ------------------------------------------------------------------------------
NODE_ENV=development
# local = H2 em memória | docker = PostgreSQL | prod = PostgreSQL gerenciado
SPRING_PROFILES_ACTIVE=local

# ------------------------------------------------------------------------------
# APPLICATION PORTS
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL local / Supabase)
# ------------------------------------------------------------------------------
POSTGRES_DB=conliz
POSTGRES_USER=conliz_admin
POSTGRES_PASSWORD=troque-esta-senha

# JDBC URL usada pelo backend (no Docker o host é o serviço `postgres`)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/conliz?sslmode=disable
# Supabase (produção/staging):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=conliz_admin
SPRING_DATASOURCE_PASSWORD=troque-esta-senha
# Driver opcional (o padrão local é org.h2.Driver)
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Gere com: openssl rand -hex 32   (mínimo 32 caracteres, HMAC-SHA256)
JWT_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres-hexadecimais
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Emissor exibido no app autenticador (Google Authenticator, Authy, 1Password)
TOTP_ISSUER=Conliz Construtora

# Cookies: COOKIE_SECURE=true obrigatório em produção (HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# CORS & NETWORKING
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# URL interna do backend usada pelas rewrites do Next.js
BACKEND_INTERNAL_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# INITIAL ADMIN USER SEED (bootstrap)
# ------------------------------------------------------------------------------
# Sem CONLIZ_ADMIN_PASSWORD o backend NÃO cria o usuário inicial.
CONLIZ_ADMIN_NAME=Diretoria Conliz
CONLIZ_ADMIN_EMAIL=admin@conliz.com.br
CONLIZ_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# HIDDEN ADMIN LOGIN PATH
# ------------------------------------------------------------------------------
# Rota obscurecida do login (noindex + bloqueio no robots.txt)
ADMIN_LOGIN_PATH=/gestao-conliz-acesso

# ------------------------------------------------------------------------------
# RATE LIMITING & BRUTE FORCE SHIELD (Bucket4j)
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_LOGIN_REFILL_MINUTES=1
RATE_LIMIT_IP_CAPACITY=60
RATE_LIMIT_IP_REFILL_MINUTES=1
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# ------------------------------------------------------------------------------
# NOTIFICATIONS & EMAILS (Contato & Fale Conosco)
# ------------------------------------------------------------------------------
NOTIFICATION_EMAIL_TO=contato@conliz.com.br
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# PUBLIC CAPTCHA (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=false

# ==============================================================================
# PRODUÇÃO — SUPABASE (banco) + RENDER (API e frontend)
# Ver DEPLOY.md. Nunca versione estes valores.
# ==============================================================================
# Postgres do Supabase (Session pooler, porta 5432, SSL obrigatório)
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
# SPRING_DATASOURCE_PASSWORD=
#
# Cookies Secure em produção (HTTPS)
# COOKIE_SECURE=true
# CORS_ALLOWED_ORIGINS=https://conliz-web.onrender.com
# FRONTEND_URL=https://conliz-web.onrender.com
#
# Frontend no Render (rewrite /api/*)
# BACKEND_INTERNAL_URL=https://conliz-api.onrender.com
# NEXT_PUBLIC_SITE_URL=https://conliz-web.onrender.com
