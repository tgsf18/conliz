# ==============================================================================
# CONLIZ PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# All sensitive variables MUST be defined here for deployment or local dev.
# Never commit real credentials to version control.

# ------------------------------------------------------------------------------
# ENVIRONMENT & GENERAL
# ------------------------------------------------------------------------------
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# APPLICATION PORTS
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Supabase PostgreSQL / Local PostgreSQL)
# ------------------------------------------------------------------------------
# For local Docker:
POSTGRES_DB=conliz
POSTGRES_USER=conliz_admin
POSTGRES_PASSWORD=conliz_secure_pass_change_me_in_prod

# JDBC URL:
# For local Docker Compose:
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/conliz?sslmode=disable
# For Supabase PostgreSQL (production/staging - sslmode=require):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=conliz_admin
SPRING_DATASOURCE_PASSWORD=conliz_secure_pass_change_me_in_prod

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key for JWT signing (minimum 256 bits / 32 characters HMAC-SHA256)
JWT_SECRET=4f8b9a2d3c1e5f7a9b0c2d4e6f8a0b1c3d5e7f9a1b3c5d7e9f0a2b4c6d8e0f1a
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Cookie domain and security flag (true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
COOKIE_DOMAIN=localhost

# ------------------------------------------------------------------------------
# CORS & NETWORKING
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# INITIAL ADMIN USER SEED (Bootstrap credentials)
# ------------------------------------------------------------------------------
CONLIZ_ADMIN_NAME=Diretoria Conliz
CONLIZ_ADMIN_EMAIL=admin@conliz.com.br
CONLIZ_ADMIN_PASSWORD=ConlizAdmin2026!#Segura

# ------------------------------------------------------------------------------
# HIDDEN ADMIN LOGIN PATH
# ------------------------------------------------------------------------------
# Obscured route for admin access (avoids bot scanners, noindex + robots.txt block)
ADMIN_LOGIN_PATH=/gestao-conliz-acesso

# ------------------------------------------------------------------------------
# RATE LIMITING & BRUTE FORCE SHIELD (Bucket4j)
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_LOGIN_REFILL_MINUTES=1
RATE_LIMIT_IP_CAPACITY=60
RATE_LIMIT_IP_REFILL_MINUTES=1
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# ------------------------------------------------------------------------------
# NOTIFICATIONS & EMAILS (Contato & Fale Conosco)
# ------------------------------------------------------------------------------
NOTIFICATION_EMAIL_TO=contato@conliz.com.br
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# PUBLIC CAPTCHA (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=false
